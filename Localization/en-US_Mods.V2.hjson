InfoDisplayText.TallyCounterVore.InvalidMeal: Meal count unavailable

StatusEffects: {
	Vanilla: {
		Buffs: {
			Campfire.Description:
				'''
				[c/{$Mods.V2.Colors.Heal}:Increases health regeneration] by [c/{$Mods.V2.Colors.Action}:{CampfireRegenFlat} HP/sec]. [c/7F7F7F:(Natural)]
				[c/{$Mods.V2.Colors.Heal}:Increases base natural regeneration buildup speed] by [c/{$Mods.V2.Colors.Action}:{CampfireNaturalRegenBuildupSpeed}].
				[c/{$Mods.V2.Colors.GoodThingVore}:Increases digestion tick rate and absorption rate] by [c/{$Mods.V2.Colors.Action}:{CampfireDigestionSpeedBonus}].
				'Everything's better with a nice, warm fire nearby'
				'''
			HeartLantern.Description:
				'''
				[c/{$Mods.V2.Colors.Heal}:Increases health regeneration] by [c/{$Mods.V2.Colors.Action}:{HeartLanternRegenFlat} HP/sec]. [c/7F7F7F:(Artificial)]
				'You feel a bit more lively than usual'
				'''
			Honey.Description:
				'''
				[c/{$Mods.V2.Colors.Heal}:Increases health regeneration] by [c/{$Mods.V2.Colors.Action}:{HoneyRegenFlat} HP/sec]. [c/7F7F7F:(Natural)]
				[c/{$Mods.V2.Colors.Heal}:Increases the speed at which natural regeneration builds up] by [c/{$Mods.V2.Colors.Action}:{HoneyNaturalRegenBuildupSpeed}].
				'Savor the sweet, delicious taste of good health!'
				'''
			Rage.Description:
				'''
				[c/{$Mods.V2.Colors.GoodThing}:Increases critical strike chance] by [c/{$Mods.V2.Colors.Action}:{RageCritChanceBonus}].
				[c/{$Mods.V2.Colors.GoodThingVore}:Increases throat strength (GLP)] by [c/{$Mods.V2.Colors.Action}:{RageGLPBonus}].
				[c/{$Mods.V2.Colors.GoodThingVore}:Increases absorption strength (ABS)] by [c/{$Mods.V2.Colors.Action}:{RageABSBonus}].
				'You and your stomach feel a rush of pointed fury'
				'''
			RapidHealing.Description:
				'''
				[c/{$Mods.V2.Colors.Heal}:Increases health regeneration] by [c/{$Mods.V2.Colors.Action}:{RapidHealingRegenFlat}]. [c/7F7F7F:(Artificial)]
				[c/{$Mods.V2.Colors.Heal}:Increases the speed at which natural regeneration builds up] by [c/{$Mods.V2.Colors.Action}:{RapidHealingNaturalRegenBuildupSpeed}].
				'''
			Regeneration.Description:
				'''
				[c/{$Mods.V2.Colors.Heal}:Increases health regeneration] by [c/{$Mods.V2.Colors.Action}:{RegenPotionRegenFlat} HP/sec]. [c/7F7F7F:(Artificial)]
				'You feel slightly revitalized'
				'''
			Swiftness.Description:
				'''
				[c/{$Mods.V2.Colors.GoodThing}:Increases movement speed] by [c/{$Mods.V2.Colors.Action}:{SwiftnessMoveSpeedBonus}].
				[c/{$Mods.V2.Colors.GoodThingVore}:Decreases stomach weight] by [c/{$Mods.V2.Colors.Action}:{SwiftnessStomachWeightReduction}].
				'You feel a bit lighter on your feet'
				'''
			Wrath.Description:
				'''
				[c/{$Mods.V2.Colors.GoodThing}:Increases damage] by [c/{$Mods.V2.Colors.Action}:{WrathDamageBonus}].
				[c/{$Mods.V2.Colors.GoodThingVore}:Increases stomach strength (TUM)] by [c/{$Mods.V2.Colors.Action}:{WrathTUMBonus}].
				[c/{$Mods.V2.Colors.GoodThingVore}:Increases acid strength (ACI)] by [c/{$Mods.V2.Colors.Action}:{WrathACIBonus}].
				'You and your stomach feel a rush of raw fury'
				'''
		}

		Debuffs.Tipsy.Description:
			'''
			[c/{$Mods.V2.Colors.GoodThing}:Increases melee damage] by [c/{$Mods.V2.Colors.Action}:{TipsyMeleeDamageBonus}].
			[c/{$Mods.V2.Colors.GoodThing}:Increases melee critical strike chance] by [c/{$Mods.V2.Colors.Action}:{TipsyMeleeCritChanceBonus}].
			[c/{$Mods.V2.Colors.GoodThing}:Increases melee attack speed] by [c/{$Mods.V2.Colors.Action}:{TipsyMeleeAttackSpeedBonus}].
			[c/{$Mods.V2.Colors.BadThing}:Decreases defense] by [c/{$Mods.V2.Colors.Action}:{TipsyDefenseCut}].
			[c/{$Mods.V2.Colors.GoodThing}:Increases fishing skill] by [c/{$Mods.V2.Colors.Action}:{TipsyFishPowerBonus}].
			[c/{$Mods.V2.Colors.GoodThing}:Increases swallow and stomach capacities] by [c/{$Mods.V2.Colors.Action}:{TipsyCapacityBonus}].
			[c/{$Mods.V2.Colors.BadThing}:Decreases digestion tick rate and absorption rate] by [c/{$Mods.V2.Colors.Action}:{TipsyChurnRateCut}].
			'''
		Summons.Pets.FairyPrincess.Description:
			'''
			A small, but very hungry prismatic fairy [c/{$Mods.V2.Colors.Action}:follows you around].
			She will [c/{$Mods.V2.Colors.GoodThingVore}:hunt down and eat nearby entities] which are shiny or twinkly enough for her tastes (including other fairies), as well as royalty.
			'The light of the fair folk illuminates all (especially her next lunch)'
			'''
	}

