		ThisIsThePredLane: >>> Pred
		ThisIsThePreyLane: Prey <<<
	}

	HorizFlip: {
		ThisIsThePredLane: >>> Prey
		ThisIsThePreyLane: Pred <<<
	}

	FNF: {
		ThisIsThePredLane: Pred
		ThisIsThePreyLane: Prey
	}

	GuitarHero: {
		ThisIsThePredLane: Pred
		ThisIsThePreyLane: Prey
	}
}

PredStatsMenu: {
	StatPointHover: {
		Default:
			'''
			You have {StatPointCount} points currently available to spend, out of {StatPointTotal} total accumulated.
			[c/7F7F7F:- {GLPSpent} invested in GLP]
			[c/7F7F7F:- {TUMSpent} invested in TUM]
			[c/7F7F7F:- {ACISpent} invested in ACI]
			[c/7F7F7F:- {ABSSpent} invested in ABS]
			'''
		RoseAddon:
			'''
			Because you're wearing [c/{RoseFlowerColor}:Rose's Flower Pin], you may add and subtract points at your leisure by clicking on this element.
			[c/{CheatedPointAllocColor}:Left-click] to add points; [c/{CheatedPointAllocColor}:right-click] to subtract them.
			[c/{CheatedPointAllocColor}:Hold LEFT SHIFT only] to add/subtract points in multiples of 10.
			[c/{CheatedPointAllocColor}:Hold LEFT SHIFT + LEFT CONTROL] to add/subtract points in multiples of 100.
			[c/{CheatedPointAllocColor}:Hold LEFT CONTROL only] to add/subtract points equal to the number of points you've earned from player pred goals.

			Cheated points become [c/{$Mods.V2.Colors.BadThingVore}:null and void] when unequipping Rose's Flower Pin.
			If you have a setup which uses more stat points than you would have after, [c/{$Mods.V2.Colors.BadThingVore}:all stat point investments will be instantly rescinded].

			Your current Flower Pin point modifier stands at [c/{$Mods.V2.Colors.Action}:{CheatedPointModifier}].
			'''
	}

	StatSliceHover: {
		Default:
			'''
			[c/{$Mods.V2.Colors.GoodThingVore}:{PredStatName} ({PredStatShorthand})]
			{SpentPoints} points invested

			Left-click to add 1 point
			Right-click to remove 1 point
			[c/FFBF00:To allocate points in sets of 10, hold LEFT SHIFT]
			[c/FFBF00:To alllocate points in sets of 100, hold LEFT SHIFT and LEFT CONTROL]
			[c/FFBF00:To alllocate all available points at once, hold LEFT CONTROL]
			'''
		Bulk10:
			'''
			[c/{$Mods.V2.Colors.GoodThingVore}:{PredStatName} ({PredStatShorthand})]
			{SpentPoints} points invested

			Left-click to add up to 10 points
			Right-click to remove up to 10 points
			[c/FFBF00:To allocate points individually, release LEFT SHIFT]
			[c/FFBF00:To alllocate points in sets of 100, hold LEFT CONTROL]
			[c/FFBF00:To alllocate all available points at once, release LEFT SHIFT and hold LEFT CONTROL]
			'''
		Bulk100:
			'''
			[c/{$Mods.V2.Colors.GoodThingVore}:{PredStatName} ({PredStatShorthand})]
			{SpentPoints} points invested

			Left-click to add up to 100 points
			Right-click to remove up to 100 points
			[c/FFBF00:To allocate points individually, release LEFT SHIFT and LEFT CONTROL]
			[c/FFBF00:To alllocate points in sets of 10, release LEFT CONTROL]
			[c/FFBF00:To alllocate all available points at once, release LEFT SHIFT]
			'''
		BulkMaximum:
			'''
			[c/{$Mods.V2.Colors.GoodThingVore}:{PredStatName} ({PredStatShorthand})]
			{SpentPoints} points invested

			Left-click to add all available points
			Right-click to remove all invested points
			[c/FFBF00:To allocate points individually, release LEFT SHIFT and LEFT CONTROL]
			[c/FFBF00:To alllocate points in sets of 10, release LEFT CONTROL]
			[c/FFBF00:To alllocate points in sets of 100, hold LEFT SHIFT]
			'''
	}

	StatDescription: {
		HoldSHIFTToSeeDescription: "[c/7F7F7F:Hold LEFT SHIFT to see more detailed descriptions of the following statistics.]"

		GLP: {
			Description:
				'''
				[c/{$Mods.V2.Colors.GoodThingVore}:Swallow Strength (GLP)] decides how good your throat is at getting your meals down and keeping them there while your stomach does its thing.

				[c/{$Mods.V2.Colors.GoodThingVore}:Influences the maximum size of prey you can swallow.]
				[c/7F7F7F:| {BaseSwallowSize} base.]
				[c/7F7F7F:| +{SwallowSizePerLevel} per stat point invested.]
				[c/{$Mods.V2.Colors.GoodThingVore}:Influences the rate at which you can drink liquids.]
				[c/7F7F7F:| {BaseDrinkRate} tiles/second base.]
				[c/7F7F7F:| +{DrinkRatePer5Levels} tiles/second per 5 stat points invested.]
				[c/{$Mods.V2.Colors.GoodThingVore}:Influences the struggle "grace period" after swallowing live prey.]
				[c/7F7F7F:| {BaseStruggleGraceTime}sec base.]
				[c/7F7F7F:| +{StruggleGraceTimePer5Levels}sec per 5 stat points invested.]
				'''

			RelevantStats:
				'''
				Total GLP: [c/{$Mods.V2.Colors.GoodThingVore}:{GLPTotal}]
				[c/7F7F7F:| {GLPSpent} from invested stat points]
				[c/7F7F7F:| {GLPBase} from permanent bonuses]
				[c/7F7F7F:| {GLPExtra} from temporary bonuses (potions, charms, etc.)]

				{$Mods.V2.PredStatsMenu.StatDescription.HoldSHIFTToSeeDescription}
				Swallow Capacity: {PreySwallowSize}
				Drinking Rate: {LiquidSwallowRate} tiles/second
				Struggle Grace Period: {StruggleGracePeriod}
				'''
		}

		TUM: {
			Description:
				'''
				[c/{$Mods.V2.Colors.GoodThingVore}:Stomach Strength (TUM)] decides how good that hungry tummy of yours is at making sure all those tasty treats you pack into it can be successfully detained to be digested.

				[c/{$Mods.V2.Colors.GoodThingVore}:Influences the maximum size your stomach can comfortably reach.]
				[c/7F7F7F:| {BaseStomachCapacity} base.]
				[c/7F7F7F:| +{StomachCapacityPerLevel} per stat point invested.]
				[c/{$Mods.V2.Colors.GoodThingVore}:Influences the capacity of the stomachache meter.]
				[c/7F7F7F:| {BaseStomachacheMeterCapacity} base.]
				[c/7F7F7F:| +{StomachacheMeterCapacityPer5Levels} per 5 stat points invested.]
				'''

			RelevantStats:
				'''
				Total TUM: [c/{$Mods.V2.Colors.GoodThingVore}:{TUMTotal}]
				[c/7F7F7F:| {TUMSpent} from invested stat points]
				[c/7F7F7F:| {TUMBase} from permanent bonuses]
				[c/7F7F7F:| {TUMExtra} from temporary bonuses (potions, charms, etc.)]

				{$Mods.V2.PredStatsMenu.StatDescription.HoldSHIFTToSeeDescription}
				Stomach Capacity: {StomachCapacity}
				Stomachache Meter Capacity: {StomachacheMeterCapacity}
				General Struggle Chart Difficulty: {StruggleChartEstimatedDifficulty}
				'''
		}

		ACI: {
			Description:
				'''
				[c/{$Mods.V2.Colors.GoodThingVore}:Acid Strength (ACI)] decides how good your stomach acids are at eating away at your prey until they just can't take it anymore, ready to be churned into a nutritious sludge in your gut.

				[c/{$Mods.V2.Colors.GoodThingVore}:Influences your base digestion tick damage.]
				[c/7F7F7F:| {BaseDigestionDamage} base.]
				[c/7F7F7F:| +{DigestionDamagePerLevel} per stat point invested.]
				[c/{$Mods.V2.Colors.GoodThingVore}:Influences the rate at which your belly deals digestion damage.]
				[c/7F7F7F:| {BaseDigestionRate} ticks/second base.]
				[c/7F7F7F:| +{DigestionRatePer5Levels} ticks/second per 5 stat points invested.]

				[c/{$Mods.V2.Colors.BadThingVore}:Certain items, such as bones, metals, certain clothing pieces, and plastics, cannot be properly digested by normal stomach acids alone.] In order to digest these items, you will need to either use external digestive aids, or upgrade your stomach acids in a more specialized manner.
				'''

			RelevantStats:
				'''
				Total ACI: [c/{$Mods.V2.Colors.GoodThingVore}:{ACITotal}]
				[c/7F7F7F:| {ACISpent} from invested stat points]
				[c/7F7F7F:| {ACIBase} from permanent bonuses]
				[c/7F7F7F:| {ACIExtra} from temporary bonuses (potions, charms, etc.)]

				{$Mods.V2.PredStatsMenu.StatDescription.HoldSHIFTToSeeDescription}
				Digestion Tick Base Damage: {DigestionDamage}
				Digestion Tick Rate: {DigestionRate} ticks/second
				{AcidTierWithDescription}
				'''

			AcidTiers: {
				Normal:
					'''
					Stomach Acid Tier: [c/9F9F9F:Normal (1)]
					Your stomach acids are just as mundane as the next predator's.
					[c/{$Mods.V2.Colors.BadThingVore}:Bones, clothing, and various other materials are easily able to survive your hungry tummy, despite its best efforts to melt them down.]

					[c/601818:The next acid upgrade method has not yet been implemented!]
					[c/C03030:Please wait until a future update implements the next acid upgrade method.]
					'''
			}
		}

		ABS: {
			Description:
				'''
				[c/{$Mods.V2.Colors.GoodThingVore}:Absorption Strength (ABS)] decides how good your digestive tract is at ensuring that every last (digestible) trace of your prey is properly refined into rich, soft cellulite to be packed onto your bottomless belly's surface (and, of course, any other areas of preference).

				[c/{$Mods.V2.Colors.GoodThingVore}:Influences the speed at which your body absorbs prey.]
				[c/7F7F7F:| {BaseAbsorbRate} weight/minute at base.]
				[c/7F7F7F:| +{AbsorbRatePerLevel} weight/minute per stat point invested.]
				[c/{$Mods.V2.Colors.GoodThingVore}:Influences the duration of status effects from eaten foods, drinks, and prey.]
				[c/7F7F7F:| Buff duration is multiplied by +{BuffExtendPer5Levels} per 5 stat points invested.]
				[c/7F7F7F:| Debuff time is divided by +{DebuffLossPer5Levels} per 5 stat points invested.]
				'''

			RelevantStats:
				'''
				Total ABS: [c/{$Mods.V2.Colors.GoodThingVore}:{ABSTotal}]
				[c/7F7F7F:| {ABSSpent} from invested stat points]
				[c/7F7F7F:| {ABSBase} from permanent bonuses]
				[c/7F7F7F:| {ABSExtra} from temporary bonuses (potions, charms, etc.)]

				{$Mods.V2.PredStatsMenu.StatDescription.HoldSHIFTToSeeDescription}
				Absorption rate: {AbsorptionRate} weight/minute
				Buffs from snacks have {BuffExtensionTime} duration
				Debuffs from snacks have {DebuffDisextensionTime} duration
				'''
		}
	}
}

PredPlayerGoals: {
	GenericText: {
		Header: {
			Title: "[c/{$Mods.V2.Colors.GoodThingVore}:Pred Player Goals]"
			Description: This is a collection of achievements, for lack of a better word, which you can complete to earn [c/{$Mods.V2.Colors.GoodThingVore}:stat points]! [c/{$Mods.V2.Colors.GoodThingVore}:Stat points] can be spent in the main pred stats menu to [c/{$Mods.V2.Colors.GoodThingVore}:make your digestive system stronger]. The more you complete and the more you progress in the rest of the game, the more goals you'll be able to view!
		}

		HoldToLearnMore: {
			Incomplete: Hold LEFT SHIFT for more specific information on how to complete this goal
			Complete: Hold LEFT SHIFT for more specific information on how you completed this goal
		}
	}

	SortingText:
		'''
		[c/{HeaderColor}:Stage Goal Sorting]
		Need to have your to-devours sorted out nice and neat?
		Try one of these options on for size!

		- [c/{DefaultSortColor}:Internal Name (default)]
		- [c/{AlphabeticalSortColor}:Alphabetical (A to Z)]
		- [c/{AlphabeticalBackwardsSortColor}:Alphabetical (Z to A)]
		- [c/{PointValueSortColor}:Point Value (Low to High)]
		- [c/{PointValueBackwardsSortColor}:Point Value (High to Low)]
		- [c/{CompletionSortColor}:Complete First]
		- [c/{IncompletionSortColor}:Incomplete First]

		[c/{CycleColor}:Left-click to cycle forwards]
		[c/{CycleColor}:Right-click to cycle backwards]
		'''

	Starter: {
		Name: Starter
		Subtitle: New Game
		Description:
			'''
			Just getting started on the wonderful world of...well, eating the world, one meal at a time? No worries; you're already free to start snacking!
			Here are some of the first things you ought to do to make sure you and your gut are as ready as can be to get some proper good eats in you!
			'''
		FooterAdvice:
			'''
			[c/{$Mods.V2.Colors.Action}:Starter Advice:]
			If you're finding the more impressive feats too difficult, remember that progressing outside of pred gameplay is important, too! Try to keep a healthy balance of pred progression and normal progression until you're certain can properly feast to your heart's content.
			'''
		UnlockCondition: start the game

		FirstLivePrey: {
			Name: First Chyme

			Description: {
				Default:
					'''
					Eat and digest your first live prey.
					'We all start somewhere.'
					'''
				Clarification:
					'''
					Eat and digest any NPC (mob or townsperson).
					To swallow an NPC this way, press the Swallow keybind while near them.
					If you cannot swallow the NPC, make sure they're not larger than your swallow or stomach capacities can currently handle.
					'''
			}
		}

		FirstItemEaten: {
			Name: Taking Inventory

			Description: {
				Default:
					'''
					Pluck something out of your normal inventory and into your internal "inventory".
					'Just couldn't wait until you found a squirmier snack to swallow, eh?'
					'''
				Clarification:
					'''
					Eat an item. Digestion is optional.
					To swallow an item, hover over it in your inventory and press the Swallow Item keybind.
					If you cannot swallow the item, make sure it's not larger than your swallow or stomach capacities can currently handle.
					Some items (e.g. Life and Mana Crystals, critters) can be swallowed on left-click by holding the Swallow Item keybind while using them.
					Some items (e.g. "normal" food and drink) force you to swallow them on use.
					'''
			}
		}

		FirstDrink: {
			Name: A Refreshing Drink

			Description: {
				Default:
					'''
					Drink a bit of water.
					'Even the best preds need a nice, cold drink every now and again! You might even get some seafood every so often as you drink, too!'
					'''
				Clarification:
					'''
					Drink a tile's worth of water.
					To drink liquids straight from the world, submerge yourself in them and hold the Swallow keybind.
					Some liquids may pose a danger to you if you drink them without proper preparation.
					'''
			}
		}
	}

	Beginner: {
		Name: Beginner
		Subtitle: Early to Mid Pre-Hardmode
		Description:
			'''
			Okay, so you know the basics now, but there's still a nigh-endless supply of succulent, mouth-watering mounds of MEAT out there for you to sink those pearly whites into as they sink into your gut.
			Try to snag a good few courses of breakfast to help yourself get used to swallowing and digesting bigger and/or squirmier meals.
			'''
		FooterAdvice:
			'''
			[c/{$Mods.V2.Colors.Action}:Beginner Advice:]
			Make sure to spend the stat points you earn from completing goals in the main pred stats menu! Each pred stat has its own advantages to investing points into it. Sometimes, you'll also be able to snag permanent buffs to these stats!
			'''
		UnlockCondition: complete all 3 of the Starter stage's goals

		SwallowAnyFurniture: {
			Name: Interior Decorator I

			Description: {
				Default:
					'''
					Decorate your tummy's insides with a piece of furniture!
					'A very touchy job, and one liable to get you glorped at any point, but the pay's really nice if you can do it well.'
					'''
				Clarification: Swallow any piece of furniture.
			}
		}

		EatManEater: {
			Name: Man Eating

			Description: {
				Default:
					'''
					Enter the Jungle and show a Man Eater who's better at eating!
					'Would that make you a Man Eater Eater?'
					'''
				Clarification: Eat and digest a Man Eater.
			}
		}

		EatGoldCritter: {
			Name: Gilded Gut Fodder

			Description: {
				Default:
					'''
					Take part in some fine local cuisine and dine on a small golden creature.
					'You sure you can digest a meal that expensi- ...oh, it's already pudge.'
					'''
				Clarification:
					'''
					Eat and digest any gold critter.
					Gold critters have a rare chance to appear in place of their respective normal counterparts.
					'''
			}
		}

		EatAngyFlower: {
			Name: Vegan Option

			Description: {
				Default:
					'''
					Nip an angry dandelion in the bud, and try out a healthier option than normal (just kidding; walking, talking MEAT is the healthiest option there is).
					'Some preds insist on never eating innocent animals. Or other people. Thankfully, there is an abundance of planty, and still very feisty, meals available for these preds to eat.'
					'''
				Clarification:
					'''
					Eat and digest an Angry Dandelion.
					Angry Dandelions can only be found and hunted down when it is a particularly windy day.
					'''
			}
		}

		EatFlyingFish: {
			Name: Simple Sky Fishing

			Description: {
				Default:
					'''
					Hook a flying fish and reel it in(to your gut) to learn the basics of sky fishing.
					'It's a really fun sport once you get past the fact that fish can fly at all. How, you ask? Better not to think about it.'
					'''
				Clarification:
					'''
					Eat and digest a Flying Fish.
					Flying Fish are fairly common, but only come swimming through the air to see your hook when it's raining.
					'''
			}
		}

		EatSnowFlinx: {
			Name: It Was So Fluffy!

			Description: {
				Default:
					'''
					Swallow up a snow flinx from deep in the tundra's caverns.
					'The fur honestly just tickles the throat on the way down, which can be bothersome...it's a REALLY comfy feeling to have one in your belly, though. It's like gulping down a huge pillow that moves around in your tummy for a while.'
					'''
				Clarification:
					'''
					Eat and digest a Snow Flinx.
					Snow Flinxes sometimes spawn in the Underground Tundra.
					-------------------------
					okay, story time: these motherfuckers used to have the most abominable spawn condition known to man. they always spawned in the Underground Tundra. but only on blocks which weren't actually classified as part of the biome (so e.g. everything the boreal wood houses are made of). to say this made it a nightmare to farm them is an understatement and a half. they're less dumb, now, though, so I wouldn't worry too much if I were you
					'''
			}
		}

		Eat3DifferentSlimes: {
			Name: Gel-y Belly

			Description: {
				Default:
					'''
					Have a bunch of different colors of tasty slime sloshing around in you all at once.
					'A great source of sugar!...very flammable and mediocre sugar, but still!'
					'''
				Clarification:
					'''
					Be digesting 3 or more different slime-type enemies simultaneously.
					All enemies counted for the Gelatin World Tour achievement are counted for the purposes of this one.
					'''
			}
		}

		EatPinky: {
			Name: Too Sweet To Live

			Description: {
				Default:
					'''
					Pop a little Pinky into your mouth and let it find its way onto your hips.
					'The little thing tastes like cotton candy, and it's small enough for just about anyone to swallow! How could someone bear to NOT gobble this little delicacy up on the spot?'
					'''
				Clarification:
					'''
					Eat and digest a Pinky.
					Pinky is a rare pink slime that rarely appears in surface forests.
					'''
			}
		}

		EatGhost: {
			Name: Ghostgutter

			Description: {
				Default:
					'''
					Got a ghost trying to haunt you? Force them to haunt your tummy instead.
					'Who ya gonna swallow?'
					'''
				Clarification:
					'''
					Eat and digest a Ghost.
					Ghosts haunt graveyards regardless of time and may also come for you when breaking tombstones.
					When the season is particularly spooky and autumn is in full swing, they may also appear on occasion in caves.
					'''
			}
		}

		EatHelpfulFairy: {
			Name: The Second Law of Predation

			Description: {
				Default:
					'''
					Down a fairy that was, at one point, leading you to treasure.
					'Fairies are food, not friends.'
					'''
				Clarification:
					'''
					Eat and digest a Fairy attempting to lead you to treasure. The color doesn't matter.
					Fairies can come out above ground as well, but only those that rarely find you in non-stomach caverns can attempt to help you find treasures to treat yourself to.
					'''
			}
		}

		EatFirstLifeCrystal: {
			Name: Healthy Rock Candy

			Description: {
				Default:
					'''
					Snack on a life crystal to boost your body's durability a little.
					'Tastes like cherry.'
					'''
				Clarification:
					'''
					Eat and digest a Life Crystal.
					Life Crystals can occasionally be found in caves and can be used or eaten to increase your maximum health.
					'''
			}
		}

		EatFirstManaCrystal: {
			Name: Magically Delicious

			Description: {
				Default:
					'''
					Snack on a mana crystal to boost your magical potential.
					'Tastes like blue raspberry.'
					'''
				Clarification:
					'''
					Eat and digest a Mana Crystal.
					Mana Crystals can be crafted with Fallen Stars and can be used or eaten to increase your maximum mana pool.
					'''
			}
		}

		EquipCharm: {
			Name: Lunchy Charm

			Description: {
				Default:
					'''
					Get a hold of a charm that can help you alleviate your tummy's troubles.
					'Even the greediest preds need some help now and again! That's what charms are for!'
					'''
				Clarification:
					'''
					Find and equip a charm for the first time.
					Charms are the primary predatory accessory you'll find in your travels, with many of them having powerful effects that help with a specific aspect of gorging yourself on the world. They can be equipped in your normal accessory slots, just as with anything else.
					'''
			}
		}

		SleepSpeedsDigestion: {
			Name: Digestive Nap

			Description: {
				Default:
					'''
					Sleep in a bed for a little while to help digest a big meal better.
					'Everyone knows a good, long nap is the #1 way to turn friends and foes alike into a doughier tum after putting in all that hard work to eat them!'
					'''
				Clarification: Get into bed with a stomach weight of 0.75 or more, and sleep in it until your belly is empty.
			}
		}

		StomachButterflies: {
			Name: A Pang of Anxiety

			Description: {
				Default:
					'''
					Snack on some butterflies. Don't they tickle in there?
					'How does the saying go again...?'
					'''
				Clarification: Have 3 or more Butterflies in your stomach at once.
			}
		}

		TooFull: {
			Name: Overstuffed

			Description: {
				Default:
					'''
					Stay at or near your maximum capacity for a full minute.
					'Eyes bigger than your stomach, eh? Happens to every newbie pred, and for good reason. It's hard to pace yourself sometimes, what with so much thick, juicy MEAT walking around everywhere...'
					'''
				Clarification: Remain at 90% fullness or higher for at least 60 seconds.
			}
		}

		DrinkHoney: {
			Name: A Revitalizing Drink

			Description: {
				Default:
					'''
					Drink a bit of honey.
					'All good things must come to an end...inside a tum like yours. Honey just so happens to be entirely too many of those good things to NOT end up churned into belly fat. It's delicious, it's deliciously fattening, it fills you up perfectly...it even gives you a bit more health as you melt it down!'
					'''
				Clarification: Drink a tile's worth of honey.
			}
		}

		BLUH: {
			Name: BLUH

			Description: {
				Default:
					'''
					Fail to contain your prey.
					[c/{$Mods.V2.Colors.JumpsuCommentary}:trial and error!]
					'''
				Clarification: Forcefully regurgitate your prey due to your stomachache meter maxing out.
			}
		}

		Calamity: {
			EatCrawler: {
				Name: Crunchy Crawler

				Description: {
					Default:
						'''
						Gulp down and gurgle a crawler in the caves.
						'With how shiny and pleasantly crunchy these "little" guys are, one can't help but wonder how they're still so abundant with all the gem-hungry predators such as yourself about.'
						'''
					Clarification: Eat and digest any Gem Crawler or a Crystal Crawler.
				}
			}

			EatFearlessGoldfish: {
				Name: Full Omen

				Description: {
					Default:
						'''
						Put the foolish ambitions of a goldfish to rest (with the help of your hungry stomach).
						'A flame inspired, snuffed in moments by the gluttonous gullet of grace.'
						'''
					Clarification: Eat and digest a Fearless Goldfish Warrior.
				}
			}
		}
	}

	Amateur: {
		Name: Amateur
		Subtitle: Mid to Late Pre-Hardmode
		Description:
			'''
			You're starting to get the hang of eating now. By now, you should be able to pack away at least another person your size...if not a bit more.
			Feel free to start hunting down the meals in this section to help train up your system even more; eating just one person at once simply won't do for much longer!
			'''
		FooterAdvice:
			'''
			[c/{$Mods.V2.Colors.Action}:Amateur Advice:]
			Many goals may be unavailable to view until you've either completed them or visited the area to which their completion check is relevant. Some may also only appear when certain NPCs are active, after certain bosses are downed, or during certain weather events.
			'''
		UnlockCondition: defeat a King Slime or the Eye of Cthulhu

		EatHarpy: {
			Name: Finger-Lickin' Good

			Description: {
				Default:
					'''
					Help yourself to a harpy, nabbed fresh from the skies.
					'Tastes like chicken. More specifically, the breasts and thighs.'
					'''
				Clarification:
					'''
					Eat and digest a Harpy.
					Harpies spawn very frequently in the Sky layer.
					Note that, prior to Hardmode, they will not spawn near the horizontal center of the world.
					'''
			}
		}

		EatNymph: {
			Name: Brrrr-eakfast Time!

			Description: {
				Default:
					'''
					Nom a hungry nymph so they don't eat you first.
					'Maybe you could make a scarf out of what's left of their hair?'
					'''
				Clarification:
					'''
					Eat and digest a Nymph.
					Nymphs are rare mobs which can be found in the lower caverns.
					'''
			}
		}

		EatBrideAndGroom: {
			Name: "'Til Death..."

			Description: {
				Default:
					'''
					Reunite the Groom and Bride...as your food.
					'Now they can stay together forever!...though your belly has a few complaints about the idea, it would seem.'
					'''
				Clarification:
					'''
					Eat and digest The Groom and The Bride. You do not need to have both in your gut simultaneously.
					Both are rare zombies which will only come out to shamble towards their prey while a Blood Moon is in the sky.
					Be advised that, as both are zombies, they will give you food poisoning while eaten/digesting.
					'''
			}
		}

		EatSquid: {
			Name: The Calamari Mood

			Description: {
				Default:
					'''
					Find a rare squid out in the ocean and treat yourself to some delicious calamari.
					[c/{$Mods.V2.Colors.ThomasCommentary}:laugh, damn you]
					'''
				Clarification:
					'''
					Eat and digest a Squid.
					Squids rarely emerge from hiding in the ocean.
					'''
			}
		}

		EatMaxLifeAndManaCrystals: {
			Name: Topped Off (For Now)

			Description: {
				Default:
					'''
					Snack on a lot of Life and Mana Crystals to top off your max health and mana (for now).
					'Feeling strong enough to snack on some properly lively prey yet, or do you need a bit more?'
					'''
				Clarification:
					'''
					Eat and digest a Life or Mana Crystal and reach the maximum for both because of it.
					Eating and digesting a Life or Mana Crystal while your max health and mana are already maxed will also complete this goal.
					'''
			}
		}

		Cheapskate: {
			Name: Lady-Sized Lollipop

			Description: {
				Default:
					'''
					Gobble up the Nurse to cheat her service fees and heal up for free (and get a free meal in the process).
					'Just what the patient ordered.'
					'''
				Clarification: While injured/debuffed enough for a traditional heal from the Nurse to cost you at least 2 gold, eat and digest the Nurse.
			}
		}

		DigestWithVoodoo: {
			Name: Long-Distance Dinner

			Description: {
				Default:
					'''
					Gleefully mulch a tasty townsperson...without ever actually swallowing them.
					'Whodoo the voodoo?'
					'''
				Clarification:
					'''
					Eat and digest a voodoo doll corresponding to a townsperson that is currently alive.
					Whether the voodoo doll is yours or not doesn't matter.
					'''
			}
		}

		CatchFallingStar: {
			Name: Wish Upon A Stomach

			Description: {
				Default:
					'''
					Let a star, falling from the outer skies, land inside your belly.
					'They say digesting a piece of the heavens above can give you the great power of magically-propelled flight! Then again, they also say that it can give you radiation poisoning...and we aren't seeing any of that as it turns into tummy fat, now, are we?'
					'''
				Clarification: Swallow a Fallen Star while it is still falling from the sky.
			}
		}

		Eat5Swords: {
			Name: Sword Swallower

			Description: {
				Default:
					'''
					Swallow a few different swords, and add each of them to the padding on your belly.
					'I don’t think that's what it's supposed to mean...'
					'''
				Clarification:
					'''
					Eat and digest at least 5 different swords that are either in the vanilla game or added by Voraria: Second Course.
					Swords which use other swords to be made somehow or another will also give credit for all of their constituent parts.
					'''
			}
		}

		DrinkLava: {
			Name: A Recalescent Drink

			Description: {
				Default:
					'''
					SAFELY drink a bit of lava. You'll need something to protect your belly from the sheer heat of a molten beverage like lava.
					'Just be careful not to drink too much; lava is VERY high in caloric contents for being thinner than honey, and you're not exactly one of the demons that drink gallons of it on the regular...'
					'''
				Clarification:
					'''
					Have an effect active which prevents damage from lava. Valid sources include:
					- Lava Charm and tinkers
					- Obsidian Skin Potion
					Swallow a tile's worth of lava.
					'''
			}
		}

		EatLargeGem: {
			Name: Pristine Pudge

			Description: {
				Default:
					'''
					Churn a giant gemstone into some grade-A ass fat.
					'Gemstones are really the best sorts of meals...tough as a rock, sky-high in calories, and expensive as all hell! Just imagine, all that unadulterated pristine WEALTH, steadily turned into nothing but a slew of caloric sludge ready to fatten up your frame...~'
					'''
				Clarification:
					'''
					Eat and digest a Large Gem.
					Large Gems can be created with a great number of their not-large counterparts.
					Be aware that gemstones and their large variants universally resist unimproved acids --- you'll need a potion or similar to increase your acid tier enough to digest them.
					'''
			}
		}

		LongGolf: {
			Name: Hole in Tum

			Description: {
				Default:
					'''
					Hit a golf ball into a faraway predator.
					'Uh... did I win?'
					'''
				Clarification: With a golf club, hit a golf ball into a predator that is 150+ tiles away from you.
			}
		}

		BecomeSomeoneElse: {
			Name: "'Til You Feel Like Someone Else"

			Description: {
				Default:
					'''
					Transform yourself via a transformation item.
					'What is thish, a crosshover- *hic!* -ebishode?'
					'''
				Clarification: Obtain and transform via a transformation item, mainly obtained through crafting with the Shimmer Concentration Cauldron.
			}
		}

		MinorConsequences: {
			Name: Minor Consequences

			Description: {
				Default:
					'''
					Snack a bit too much and notice a bit of padding on you.
					[c/{$Mods.V2.Colors.JumpsuCommentary}:i mean you signed up for this]
					[c/{$Mods.V2.Colors.JumpsuCommentary}:it says it on the item]
					'''
				Clarification:
					'''
					Reach a weight of 1.2, ignoring your stomach's contents.
					[c/{$Mods.V2.Colors.JumpsuCommentary}:do note that you can only gain weight with a transformation active]
					'''
			}
		}

		Chunky: {
			Name: Chunky...

			Description: {
				Default:
					'''
					You just can't afford to take a break on eating, can you?
					[c/{$Mods.V2.Colors.JumpsuCommentary}:i endorse this]
					[c/{$Mods.V2.Colors.JumpsuCommentary}:keep eating... get fatter...]
					'''
				Clarification:
					'''
					Reach a weight of 2, ignoring your stomach's contents.
					[c/{$Mods.V2.Colors.JumpsuCommentary}:do note that you can (still) only gain weight with a transformation active]
					'''
			}
		}

		EatFungalGift: {
			Name: Strangely Delicious

			Description: {
				Default: You aren't sure what a 'Fungal Gift' ACTUALLY is, but it tastes...really good, actually? Well, down the hatch with it!
				Clarification: Eat and digest a Fungal Gift.
			}
		}

		DigestDungeonBrick: {
			Name: Eat The Dungeon

			Description: {
				Default:
					'''
					Have your gut successfully melt a piece of the dungeon.
					'...wait, what do you mean you don't actually eat the dungeons in that game? What a scam.'
					'''
				Clarification: Eat and digest a Pink, Green or Blue Brick.
			}
		}

		EatBlazingWheel: {
			Name: Not Movin' An Inch

			Description: {
				Default: Let a Blazing Wheel roll straight into your stomach.
				Clarification: Eat and digest a Blazing Wheel.
			}
		}

		EatSpikeBall: {
			Name: Out Of The Way

			Description: {
				Default:
					'''
					Swallow one of those annoying spinning spike balls from the dungeon.
					'Good riddance!'
					'''
				Clarification: Eat and digest a Spike Ball.
			}
		}
	}

	Intermediate: {
		Name: Intermediate
		Subtitle: End of Pre-Hardmode / Early Hardmode
		Description:
			'''
			Alright. You've got a good grip on gulping down things bigger than yourself; time for lunch!
			These latest meals should give your belly a nice big buffet to work on while you're busy preparing for even bigger snacks to come!
			'''
		FooterAdvice:
			'''
			[c/{$Mods.V2.Colors.Action}:Intermediate Advice:]
			Keep an eye on your [c/{$Mods.V2.Colors.GoodThingVore}:acid tier]. Some of your tastiest prey may be entirely immune to normal acids, and that'll mean you can't churn them into tummy fat! As such, be on the lookout for ways to raise your acid tier; some may be tied to progression (in future updates)...
			'''
		UnlockCondition: defeat Skeletron

		EatMimic: {
			Name: Mimic's Miscalculation

			Description: {
				Default:
					'''
					Munch on a mimic (before it can do the same to you).
					'Now you're just hoarding its hoard in your belly, which could itself be considered a hoard, albeit strictly for food that your system hasn't digested yet. Does this qualify as hoardception...?'
					'''
				Clarification:
					'''
					Eat and digest any kind of Mimic.
					Mimics only emerge in Hardmode, and can be found at varying elevations underground.
					Larger mimics may spawn in tainted areas, and are much stronger, but have their own drops.
					'''
			}
		}

		EatSandElemental: {
			Name: Bite The Dust

			Description: {
				Default:
					'''
					Swallow up a sand elemental and add her to your figure.
					'Everyone hates sand. It's coarse, it's rough, and it gets all over you. It even gets all over your stomach walls when you gulp down a pretty girl made out of it. Thankfully, your stomach can resolve that problem fairly quickly by melting down even the smallest grains of sand, and the biggest and prettiest of sand girls, into smooth, soft, squishy cellulite.'
					'''
				Clarification:
					'''
					Eat and digest a Sand Elemental.
					Sand Elementals are rare, large ladies that manifest during desert sandstorms in Hardmode.
					'''
			}
		}

		EatIceGolem: {
			Name: Walking Popsicle

			Description: {
				Default:
					'''
					Gulp and gurgle a golem grown of ice.
					'It really is one, if you think about it. Very tall, rather lean, wide enough to suckle on a while as you swallow it, melts a little in your mouth...and tastes just like an ice cube!'
					'''
				Clarification:
					'''
					Eat and digest an Ice Golem.
					Ice Golems can only be found in Hardmode where fierce blizzards batter the snowy tundra.
					'''
			}
		}

		EatShark: {
			Name: Shark Ate

			Description: {
				Default:
					'''
					Lure in a shark to turn the tables on it.
					'Ooh ha ha!'
					'''
				Clarification:
					'''
					Eat and digest a Shark.
					Sharks commonly spawn in the ocean at any time of day.
					'''
			}
		}

		EatFallenAngel: {
			Name: Sanctum of Gastric Grace

			Description: {
				Default:
					'''
					Gobble up an angel warped by the evils of the world, cleansing them of their ailment in the process.
					'A massive meal from on high, seasoned with the aftertastes of sin...a delicious treat, aren't they?'
					'''
				Clarification:
					'''
					Eat and digest a Fallen Angel.
					Fallen Angels rarely appear in the Corruption and Crimson, a bit more commonly in the caves of these accursed places, and will try to cram themselves into you if you have enough space to hold them; if not, they will cram you and themselves into the nearest predator, if possible.
					'''
			}
		}

		HoardGemCritters: {
			Name: Squirmy Sparklers

			Description: {
				Default:
					'''
					Hoard a bunch of different gem critters in your belly.
					'Sparkly meals like that DESERVE to be gut fat! Betcha that fox girl never told you anything about these...'
					'''
				Clarification:
					'''
					Eat 7 different Gem Critters simultaneously. Being mid-digestion does still count, but is not required.
					Gem Critters --- comprised of Bunnies and Squirrels --- can come out to play wherever townsfolk live underground.
					Be aware that Gem Critters universally resist unimproved acids --- you'll need a potion or similar to increase your acid tier enough to digest them.
					'''
			}
		}

		GivePromethiaBellyBath: {
			Name: Divine Belly Bath
			Description:
				'''
				Drink a notable amount of homemade holy water, then eat Promethia to treat her to a nice bath.
				'It's not as good as the stomachs and saunas alike she knows from home, but she loves the experience nonetheless! Somehow, she's given you multiple stat points for this. How, you might ask? It's simple.

				Don't underestimate the enticing nature, and latent magical abilities, of a dedicated gut slut.'
				'''
		}

		BoulderBelly: {
			Name: Rock in Rolls

			Description: {
				Default:
					'''
					Gulp down a Boulder so it doesn't flatten you like the big, juicy pancake a hungry pred could treat you as afterwards.

					[c/{Mods.V2.Colors.ThomasCommentary}:...this joke sounded a lot funnier in my head]
					'''
				Clarification: Eat and digest a rolling Boulder.
			}
		}

		EatCouch: {
			Name: Couch Potato

			Description: {
				Default:
					'''
					Eat a couch. No, not figuratively, LITERALLY convert a whole-ass couch into stomach sludge.
					'You're far from the first and, potentially, won't be the last.'
					'''
				Clarification: Eat and digest any Sofa.
			}
		}

		Fatty: {
			Name: Fatty!

			Description: {
				Default:
					'''
					I think you've had enough prey for a long time.
					[c/{$Mods.V2.Colors.JumpsuCommentary}:i think you HAVEN'T had enough and that you need MORE]
					'''
				Clarification:
					'''
					Reach a weight of 3.5, ignoring your stomach's contents.
					[c/{$Mods.V2.Colors.JumpsuCommentary}:do note that you can only gain weight with a transformation active]
					'''
			}
		}

		JustABitMore: {
			Name: One More Bite Couldn't Hurt

			Description: {
				Default: Have three times your stomach capacity in food inside your gut. How are you keeping all of that in?
				Clarification: Have 300% or more stomach fullness.
			}
		}

		PerfectMeal: {
			Name: Perfect Meal

			Description: {
				Default: Get the maximum stat boost you can get from Well Fed.
				Clarification: Have enough delicious stuff in your stomach to get the best boost possible from the Well Fed buff.
			}
		}

		EatRainbowDye: {
			Name: Taste the Rainbow

			Description: {
				Default: Go through the whole process of making rainbow dye...just to eat it? Okay, whatever, sure.
				Clarification: Swallow and digest Rainbow Dye, which can be made at a Dye Vat using a menagerie of other dyes.
			}
		}
	}

	Skilled: {
		Name: Skilled
		Subtitle: Mid-Hardmode
		Description:
			'''
			You're turning into a real glutton now, aren't you? A fitting case, given how many lives your gut's probably ended by now.
			Be wary, though. Many of your most impressive meals-to-be will definitely be more than willing to make you into a swiftly-churned snack yourself if you're not careful!
			'''
		FooterAdvice:
			'''
			[c/{$Mods.V2.Colors.Action}:Skilled Advice:]
			[c/{$Mods.V2.Colors.BadThingVore}:You are not invincible.] You may believe you are at this stage, but you're not. If you want to TRULY become invincible...you'll need to start adding the biggest buffets to your greedy gut's list of accomplishments.
			'''
		UnlockCondition: defeat a mechanical monstrosity

		EatBigBoss: {
			Name: Behold The Boss Eater

			Description: {
				Default:
					'''
					Take down a particularly powerful foe with nothing but your greedy gullet and gut.
					'You could say they entered the gutgeon.'
					'''
				Clarification:
					'''
					Eat and digest a boss.
					Bosses are extremely difficult to devour, usually requiring special items or abilities to get down and heavy investment in all non-ABS pred stats to keep down. That said, bosses are also extremely high in calories (very good news for your greedy tummy) and also typically grant access to unique pred abilities once what's left of them settles down on your frame.
					'''
			}
		}

		EatObserver: {
			Name: That Big Ol' Eye

			Description: {
				Default:
					'''
					Somehow swallow up one of the biggest eyes in the sky.
					'So much for incidentally evolving to be nigh-unswallowable.'
					'''
				Clarification: Eat and digest an Observer.
			}
		}

		HoardLargeGems: {
			Name: Plentiful Pristine Pudge

			Description: {
				Default:
					'''
					Churn a collection of massive gemstones into a massive new muffin top.
					'See? What did I tell you? Giant gems make for a WEALTH of premium tummy pudge, and they're just as much of a flex to gobble up, too! Imagine how much people would've paid you for all that premier belly fodder, now nothing more than dozens of pounds hanging off your belly and elsewhere...~'
					'''
				Clarification:
					'''
					Eat and digest 7 Large Gems simultaneously.
					Be aware that gemstones and their large variants universally resist unimproved acids --- you'll need a potion or similar to increase your acid tier enough to digest them.
					'''
			}
		}

		BlasterLoophole: {
			Name: INFINITE FOOD GLITCH (real) (not patched) (2008)

			Description: {
				Default:
					'''
					Eat a burger from your own Dinner Blaster.
					'Is this cheating? This feels like cheating.'
					'''
				Clarification:
					'''
					Shoot the Dinner Blaster, then immediately swallow the fired burger.
					The Dinner Blaster is bought from Clover when the Cyborg is present.
					'''
			}
		}

		MajorConsequences: {
			Name: Major Consequences

			Description: {
				Default:
					'''
					What have you been eating?! I hope you have something to help with lugging your fat gut around.
					[c/{$Mods.V2.Colors.JumpsuCommentary}:a thing to note; the bigger a pred is, the less weight they gain from eating]
					[c/{$Mods.V2.Colors.JumpsuCommentary}:additionally for player preds like you, they'll lose weight faster too]
					[c/{$Mods.V2.Colors.JumpsuCommentary}:so you better greedily devour everything you see if you hope to get here]
					'''
				Clarification:
					'''
					Reach a weight of 10!
					[c/{$Mods.V2.Colors.JumpsuCommentary}:stomach weight is still excluded]
					'''
			}
		}

		HaveWeGoneTooFar: {
			Name: '''"...Have we gone too far?"'''

			Description: {
				Default:
					'''
					We? Who's WE? This is all on you! How would you even get this fat?
					[c/{$Mods.V2.Colors.JumpsuCommentary}:i believe you can do this somehow]
					[c/{$Mods.V2.Colors.JumpsuCommentary}:afterall, you want those points, right?]
					'''
				Clarification:
					'''
					Reach a weight of... 40!? WHAT.
					[c/{$Mods.V2.Colors.JumpsuCommentary}:stomach weight is STILL excluded]
					'''
			}
		}

		HowDidWeGetHere: {
			Name: How Did We Get Here?

			Description: {
				Default:
					'''
					...I'm out.
					[c/{$Mods.V2.Colors.JumpsuCommentary}:its the final challenge!]
					[c/{$Mods.V2.Colors.JumpsuCommentary}:100 weight or bust, can you do it?]
					'''
				Clarification:
					'''
					[c/{$Mods.V2.Colors.JumpsuCommentary}:reach a weight of a grand total of 100]
					[c/{$Mods.V2.Colors.JumpsuCommentary}:how many empresses did you have to eat for this]
					'''
			}
		}

		Recycler: {
			Name: Recycler

			Description: {
				Default: Get the worst stat debuffs you can get from Well Fed.
				Clarification: Have enough dubiously edible stuff in your stomach to get the worst debuff possible from the Well Fed 'buff'.
			}
		}

		EatReaper: {
			Name: Ch'eating' Death

			Description: {
				Default:
					'''
					Give Death a taste of it's own medicine... With your own twist on it.
					[c/{$Mods.V2.Colors.JumpsuCommentary}:okay they arent really like. THE grim reaper and just... regular reapers]
					[c/{$Mods.V2.Colors.JumpsuCommentary}:whatever go eat one]
					'''
				Clarification: Eat and digest a Reaper during a Solar Eclipse.
			}
		}

		DigestTempleBrick: {
			Name: Temple Mulcher

			Description: {
				Default: Manage to digest a piece of the so-called 'impenetrable' temple.
				Clarification: Eat and digest a block of Lihzahrd Brick.
			}
		}

		EatMothronEgg: {
			Name: Raw Moth Omelette

			Description: {
				Default:
					'''
					Consume a Mothron's egg.
					[c/{$Mods.V2.Colors.JumpsuCommentary}:what would an omelette made with a mothron egg taste like]
					'''
				Clarification: Eat and digest a Mothron Egg, spawned from a Mothron during a Solar Eclipse.
			}
		}
	}
}

