Menu: {
	ShimmerCraftingStation: {
		Decrafting: {
			Title: Separation
			Description:
				'''
				Place an item in the item slot shown below to see what you will receive from separating it into its constituent components.
				If you're certain you'd like to separate the item, press the visage of a button to begin.
				[c/{$Mods.V2.Colors.Red:Only separate an item if you are content with what you will receive from doing so; the process cannot be undone.]
				'''
		}

		Transmuting.Title: Transmutation
		CrossoverItemCrafting.Title: Parallel Projection
	}

