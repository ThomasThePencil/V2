				Dryad: {
					1: "{0} has been reunited with nature, thanks to {1}."
					2: "{0} made for great fertilizer to help {1} grow stronger."
					3: "{1} decided purifying {0} was the best course of action."
					4: "{1} knows she can't quite photosynthesize; thankfully, snacking on {0} was close enough."

					TaintedWorld: {
						1: "{1} got too frustrated at {0}'s continued failure to push back the evils of the world."
						2: "{0} got mulched with ease because they wouldn't do {1}'s job for her."
						3: According to {1}, {0} is fantastically bad at cleansing. Not surprising, since they're busy filling out her backside now.
					}

					Hardcore:
						'''
						{0} was, perhaps rather forcibly, made one with nature through {1}'s purifying stomach.
						Their sacrifice will live on as she prepares further to add a great evil from far beyond Terraria to her waistline...
						'''
				}

				Succubus: {
					1: "{0} was forced to fatten up {1}'s demonic derriere."
					2: "{0}'s body is now stored on {1}'s hellish hips."
					3: "{1} is one step closer to being the fattest demon in the world, thanks to {0}."
					4: "{0} helped thicken up {1}'s satanic sides even further."
					5: "{1} promised {0} a fun time...and figured that a night of hanging off her midsection counts."

					StomachSuffocation: {
						1: "{0}'s lungs couldn't handle {1}'s infernal internals."
						2: "{1}'s searing stomach scorched {0}'s respiratory system."
					}

					Hardcore:
						'''
						{0}'s body and soul alike were churned into some new chest fat for {1}.
						Maybe now, she'll be able to use that strength to become the apex pred she's wanted to be.
						'''
				}

				Mechanic: {
					1: '''{1}'s system converted {0} into "potential energy".'''
					2: "{0} helped to recharge {1}'s batteries."
					3: "{1} took a snack break with {0}."
					4: "{1}'s system caused {0} to short-circuit."
					5: "{0} suffered a blackout in {1}'s stomach."
					6: "{0} was fixed."
					7: "{0} was scrapped."
					8: "{0} was turned into a battery by {1}."
					Hardcore: "{0} has become the best battery {1}'s ever used, at the cost of their continued existence."
				}

				Painter: {
					1: "{1} found {0} too colorful a snack to pass up."
					2: "{0} was painted red by the stomach of a starving artist."
					3: "{1} swallowed up {0} to focus on his next masterpiece...even though they wouldn't stop fighting to get out of his gut."
					4: "{0} didn't stop jostling around {1}'s gut, and now he's gotta start his newest artwork over because of a wrong brushstroke. How rude!"
					5: "{0} made a great model for {1}'s latest artpiece!...of himself with a nice, full belly!"
					Hardcore:
						'''
						{1} seems to be finishing up painting a beautiful picture! What's it a picture of?

						...oh! It's of {0}'s last moments digesting in his gut!
						What a lovely way to send them off as they churn into more of his ass...
						'''
				}

				PartyGirl: {
					1: "{1} had {0} as a pre-party pick-me-up."
					2: "{0} will be the life of the party as {1}'s tum fat."
					3: "{1} thought {0} tasted...almost as good as candy."
					4: "{1} melted {0} into liquid confetti."
					5: "{0} partied too hard in {1}'s belly."
					6: "{0} was sloshed to the beat of the drums by {1}."
					Hardcore:
						'''
						The last anyone ever saw of {0} was a breathy, bubbly belch from {1}, bringing up a bundle of heated, half-liquid confetti.
						At least the gut fat they left on her will keep her the life of the party for many weeks to come.
						'''
				}

				Steampunker: {
					1: "{1} needed fuel for her engine; fuel which {0} was all too eager to provide."
					2: "{0} was flawlessly converted to steam inside {1}'s mechanisms."
					3: "{1} fed {0} into her countless internal devices and doohickeys."
					4: "{1} hid {0} away in her stomach, never to see the sun again."
					5: "{0} wanted to know how steam is made. {1} happily demonstrated."
					6: The only thing left of {0} is a healthy gutful of steam inside {1}.
					7: "{1}'s body has become a little bit denser, thanks to {Prey}."
					Hardcore:
						'''
						No conclusive evidence will ever be found of where {0}'s one life disappeared to.
						The only clue left behind? {1} having higher density than usual and belching up a healthy amount of steam.
						'''
				}
			}

			Hallow: {
				EmpressButterfly: {
					1: "{0} was mesmerized too long by a butterfly."
					2: How is a teensy little butterfly strong enough inside to make a meal of {0}...?
					3: Somehow, {0}'s even lower on the food chain than the Empress' favorite dessert.
					Hardcore:
						'''
						{0} somehow crammed themselves into the ravenous belly of a tiny, twinkly butterfly.
						A bit of an odd choice for how to end their only life, but we don't judge here.
						It'll end up lining the Empress' fat thighs before long, anyway.
						'''
				}
			}

			Bosses: {
				UnreasonablyThickFairy: {
					1: "{0} became a light snack for the Empress of Light."
					2: The Empress' gut blinded {0} just a little too long.
					3: "{0} was too enamored by the Empress' shiny stomach walls to fight their way out."
					4: Maybe now, {0} can tell you if the Empress' tummy is twinklier on the inside.
					Hardcore:
						'''
						{0} was, sadly, far too enamored by the Empress' mesmerizingly twinkly tummy walls to fight their way out.
						The only evidence left of their only chance at existence will be a fresh new layer of fat on her already-thick thighs.
						'''
				}
			}
		}

		SpecificProjectile: {
			Summons: {
				Pets: {
					MiniCandyFairy: {
						1: "{0} became a not-very-light snack for the Heiress of Light."
						2: A fairy princess' gut mesmerized {0} just a little too long.
						3: "{0} was too enamored by their prismatic fairy companion's shiny stomach walls to fight their way out."
						4: The Princess of Light's stomach must've been just as twinkly as the Empress' for {0} to get stuck so long.
						Hardcore:
							'''
							{0} fought many tough battles and even outlasted the voracious Empress of Light, befriending an apprentice of hers in the process.
							That apprentice, steadily growing fatter by the minute due to caloric excess, is now their gastric tomb.
							'''
					}
				}
			}
		}
	}

	OverlyHungryPlayer: {
		UnsafeLavaDrink: {
			1: "{0} had a drink that was a little too warm."
			2: "{0} learned why demons bathe in lava more often than drinking it."
			3: "{0} was smelted from the inside out."
		}

		UnsafeShimmerDrink: {
			1: "{0}'s stomach ended up where their stomach should be, while it was still already there. Quantum mechanics are fun!"
			2: "{0} thought the Empress' bathwater would look sparklier in their gut."
			3: "{0} decided to see if shimmer would make their belly glowy and glimmery. It did...for about 5 seconds before they died."
		}
	}

	DigestedTownNPC: "{0} was eaten..."
