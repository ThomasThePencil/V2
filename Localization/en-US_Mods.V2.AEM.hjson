Items: {
	Accessories: {
		Offensive: {
			SharkToothNecklace: {
				Name: Shark Tooth Necklace
				Overview:
					'''
					Can be worn as a necklace.
					While worn, confers the following effects:
					> [c/{$Mods.V2.Colors.Action}:All of your attacks] gain [c/{$Mods.V2.Colors.Yellow}:+{SharkToothNecklaceArmorPen} armor penetration].
					> [c/{$Mods.V2.Colors.Lime}:+{SharkToothNecklacePredPoints} point] in [c/{$Mods.V2.Colors.Green}:GLP and ACI pred stats].
					'''
			}

			StingerNecklace: {
				Name: Stinger Necklace
				Overview:
					'''
					Can be worn as a necklace.
					While worn, confers the following effects:
					> [c/{$Mods.V2.Colors.Action}:All of your attacks] gain [c/{$Mods.V2.Colors.Yellow}:+{StingerNecklaceArmorPen} armor penetration].
					> [c/{$Mods.V2.Colors.Lime}:+{StingerNecklacePredPoints} point] in [c/{$Mods.V2.Colors.Green}:GLP and ACI pred stats].
					> [c/{$Mods.V2.Colors.Yellow}:+{StingerNecklaceCritDMG} critical strike damage].
					'''
			}
		}

		Defensive: {
			AdhesiveBandage: {
				Name: Adhesive Bandage
				Overview:
					'''
					Can be worn in accessory slots.
					While worn, confers the following effects:
					> The health regeneration reductions from [c/{$Mods.V2.Colors.DarkRed}:Bleeding], [c/{$Mods.V2.Colors.DarkRed}:Heavy Bleeding], and [c/{$Mods.V2.Colors.DarkRed}:Fatal Bleeding] are [c/{$Mods.V2.Colors.Green}:reduced by {AdhesiveBandageBleedRegenReducReduc].
					> The health loss per attack from [c/{$Mods.V2.Colors.DarkRed}:Bleeding], [c/{$Mods.V2.Colors.DarkRed}:Heavy Bleeding], and [c/{$Mods.V2.Colors.DarkRed}:Fatal Bleeding] is [c/{$Mods.V2.Colors.Green}:reduced by {AdhesiveBandageBleedAttackHealthLossReduc}]. [c/{$Mods.V2.Colors.DarkGrey}:(Rounds down.)]
					> [c/{$Mods.V2.Colors.DarkGreen}:Softened] requires [c/{$Mods.V2.Colors.Yellow}:+{AdhesiveBandageSoftenedDMG} more digestion damage taken] to gain a stack.
					[c/{$Mods.V2.Colors.Red}:Destroyed] when durability is depleted by digestion damage.
					'''
			}

			MedicatedBandage: {
				Name: Medicated Bandage
				Overview:
					'''
					Can be worn in accessory slots.
					While worn, confers the following effects:
					> The health regeneration reductions from [c/{$Mods.V2.Colors.DarkRed}:Bleeding], [c/{$Mods.V2.Colors.DarkRed}:Heavy Bleeding], and [c/{$Mods.V2.Colors.DarkRed}:Fatal Bleeding] are [c/{$Mods.V2.Colors.Green}:reduced by {MedicatedBandageBleedRegenReducReduc].
					> The health loss per attack from [c/{$Mods.V2.Colors.DarkRed}:Bleeding], [c/{$Mods.V2.Colors.DarkRed}:Heavy Bleeding], and [c/{$Mods.V2.Colors.DarkRed}:Fatal Bleeding] is [c/{$Mods.V2.Colors.Green}:reduced by {MedicatedBandageBleedAttackHealthLossReduc}]. [c/{$Mods.V2.Colors.DarkGrey}:(Rounds down.)]
					> [c/{$Mods.V2.Colors.DarkGreen}:Softened] requires [c/{$Mods.V2.Colors.Yellow}:+{MedicatedBandageSoftenedDMG} more digestion damage taken] to gain a stack.
					> Grants [c/{$Mods.V2.Colors.Green}:immunity] to [c/{$Mods.V2.Colors.Green}:Poisoned].
					[c/{$Mods.V2.Colors.Red}:Destroyed] when durability is depleted by digestion damage.
					'''
			}
		}
	}

	Tools: {
		PredToggleRod: {
			Name: Rod of Objectum
			Overview:
				'''
				Can be used in the hotbar or as a cursor item.
				[c/{$Mods.V2.Colors.Action}:Left-click] to select the placeable item closest to the cursor, outlining it in [c/{$Mods.V2.Colors.Green}:green].
				[c/{$Mods.V2.Colors.Action}:Right-click] with a placeable item selected to [c/{$Mods.V2.Colors.Action}:cycle that item between the following appetite tunings:]
				> Reserved (will not eat anything)
				> Friendly (will not eat you or townsfolk, but will randomly eat others)
				> Indiscriminate (will randomly eat anything that comes near)
				Most placeable items default to Reserved. Some do not; make sure you take note of which ones default to which.
				'''
			Flavor: A- all sorts of objects that you might not think are animate are- ...are still r- really hungry! They know to k- keep their appetites to themselves, usually, b- but sometimes, they get a bit...uncooperative or overenthusiastic. S- so! To alleviate that...concern, this scepter was first made in the golden age of Avarsici by combining shimmer, r- royal...h- heft, and imported sugarsteel! The result can easily 'tune' an object's a- appetite to your liking!
		}
	}

	Misc: {
		AEM: {
			Name: All-Encompassing Menu
			Overview:
				'''
				The item you're reading this entry from the contents of.
				[c/{$Mods.V2.Colors.Action}:Left-click] on it while held to open it up and look through it!
				Can show you [c/{$Mods.V2.Colors.Action}:detailed information] about items, projectiles, NPCs, and anything else you happen to encounter on your journey.
				Items with entries allow you to [c/{$Mods.V2.Colors.Action}:press {AEMQuickOpenToItemBind} while hovering over them] to quick-nav to their entry.

				[c/{$Mods.V2.Colors.Red}:Cannot be eaten until you have met St. Promethia and had her remove its consumption lock.]
				Afterwards, if you ate yours or need another, you can [c/{$Mods.V2.Colors.Action}:buy more from her] for 15 Concertissimo Tickets a piece.
				'''
			Flavor: The main menu itself! E- everyone at the Gluttony Gallery gets one for their f- first visit, and can take as many more as they want afterwards! O- of course, I usually go there to s- see everyone e- else stuff themselves...a- and be o- on the menu...but! You can use it to learn all about your f- future meals, a- and anything you can get d- digested by!
		}
	}
}

NPCs: {
	Generic: {
		BehaviorNoteUnlock: " to reveal this note."
		LootTableUnlock: Defeat or digest a {Title} to reveal possible loot.
	}

	Tundra: {
		Nymph: {
			Name: Nymph
			Subtitle: Damsel (Or Not) Of Distress
		}
	}

	Jungle: {
		Piranha: {
			Name: Piranha
			Subtitle: Quite Unlike A Present
			Overview: A r- ravenous species of fish which dwells within the Jungle's many rivers and lakes. Often found swimming in modestly-sized groups, or alone in small enough bodies of water, they'll waste no time t- tearing apart and gulping down any oh-s- so-unfortunate f- food that enters their territory. They can even prove a threat outside of water, though they can't remain outside of it for long, l- lest they put themselves at risk of asphyxiation.
			SpawnCondition: This common species of fish is found [c/{$Mods.V2.Colors.Aqua}:in the Jungle's waters]! While small bodies of water can produce lone piranhas, they are most often found in [c/{$Mods.V2.Colors.Aqua}:schools of 2-5].

			BehaviorNotes: {
				Passive: {
					Function: If you're not in the water and haven't provoked them, Piranhas will [c/{$Mods.V2.Colors.Aqua}:swim around peacefully], only preying upon [c/{$Mods.V2.Colors.Aqua}:other sea creatures] such as fish and turtles.
					Flavor: Believe it or not, piranhas aren't actually intrinsically out to g- gobble up adventurers or citizens!...e- even if I wish they'd do it to m- me! They're very calm when people don't disturb the waters (or o- offer themselves up as f- fish food), and their most common prey include other jungle fish; they'll usually swallow smaller prey wh- whole.
				}

				HostileInWater: {
					Unlock: Dive into water near a Piranha
					Function: Entering water while a Piranha is nearby will [c/{$Mods.V2.Colors.Action}:cause it to target you]; it will give chase for as long as you remain in the water.
					Flavor: You won't want to dip your feet into the water when a piranha's around, u- unless you're looking to end up as f- fish food; th- they'll see you, recognize you as a potential m- meal, and swim towards you super fast to try and get their fill of ange- ...a- adventurer meat.
				}

				HostileOutOfWater: {
					Unlock: Lead a Piranha out of water, or have one latched to you out of water,
					Function: Piranhs will [c/{$Mods.V2.Colors.Damage}:continue to chase you] when you leave the body of water they inhabit if they had aggro'd on you previously.
					Flavor: Piranhas are very persistent when, ah...t- trying to make a m- meal of something, or someone! Of course, out of water, they can't eat you TOO easily...they'll only s- swallow you up once there's a good stream of blood coming out. It's like an organic lubricant, and it also fires up their p- predatory instincts!
				}

				Schooling: {
					Unlock: Encounter a school of Piranhas
					Function:
						'''
						Piranhas will form schools when many are nearby.
						Swallowing a Piranha which is part of a school will [c/{$Mods.V2.Colors.BadThing}:cause all other Piranhas in that school to immediately aggro onto you]. Piranhas which are aggro'd this way will not try to eat you, but will deal damage via biting more often once latched on.
						'''
					Flavor: While they have a very p- particular 'first come, first served' rule on their f- food, piranhas are very communal by nature; they often school for a sense of protection from p- predators! If you g- gobble up a piranha near its schoolmates, the others will r- really aggressively chase you down to s- save their friend, even leaping out from the water r- right towards you!
				}

				CatchAndRelease: {
					Unlock: Catch a Piranha with a net
					Function:
						'''
						Piranhas can be [c/{$Mods.V2.Colors.Action}:caught with a Bug Net or better], granting you an item: [i:CaughtPiranha].
						Unlike most catchable creatures, releasing a caught Piranha throws it as a throwing weapon.
						The first entity the Piranha contacts will take damage, scaling with your throwing damage bonuses.
						If the entity is [c/{$Mods.V2.Colors.Red}:Bleeding], they will be [c/{$Mods.V2.Colors.GoodThingVore}:instantly swallowed] by the Piranha.
						'''
					Flavor: Piranhas...don't like being caught. At all. Even when being carried around, they'll often do their best to ch- chomp on you and get a m- meal out of it!
				}

				ExpertLifesteal: {
					Unlock: Take damage from a Piranha
					Function: The biting damage from a Piranha will [c/{$Mods.V2.Colors.Heal}:heal] the Piranha for [c/{$Mods.V2.Colors.Damage}:{PiranhaLifestealModifier} of damage dealt] (rounds down).
					Flavor: The blood which piranhas tend to draw from their victims can often find itself r- running back into the piranha's maw...which, alongside its natural lubricating properties, also helps to revitalize them! Studies have shown that piranhas' i- intestinal tracts can dilute blood into an extra-nutritious mixture which is s- swiftly distributed to the rest of the body to boost cell regeneration a- and speed up the healing of wounds!
				}

				MasterSmartFlop: {
					Unlock: Lead a Piranha out of water
					Function: Piranhas which are out of water will [c/{$Mods.V2.Colors.Aqua}:actively flop towards nearby bodies of water] if any are available and they are not currently hunting a meal.
					Flavor: Piranhas, while much less actionable overall out of water, are very smart fish; they'll always try to flop and hop their way back to water if they end up out of it for too long without good food to chase. After all, while they CAN survive quite a while outside of water, they don't want to die of oxygen loss!
				}

				Stomach: {
					Unlock: Feed St. Promethia to, or get eaten by, a Piranha
					Function: Piranhas' stomach acids innately have [c/{$Mods.V2.Colors.Damage}:8 armor penetration].
					Flavor: ...m-mmf...they're so slick and s- slippery inside, but their a- acids are quick to g- get in there when food's r- ready to digest. It's like a little bloodth-thirsty pond of comfortable, c- crackling belly juices...and their stomach a- acids hit just as hard as their teeth, too! They're...mhf- v- very adept at getting past the natural a- armor of their most common prey, that being o- other fish...a- and m- me, when I'm l- lucky enough to f- find one...
				}
			}
		}
	}
}

DivineIntervention: {
	Title: Divine Intergestion
	Overview:
		'''
		Are you mortally terrified by the idea of specific sorts of preds eating you? Mortified at the idea they so much as exist?

		...well, the divines won't help you with that second part. It would disrupt the delicate balances of the ecosystem too greatly for the Timekeeper's tastes. But they CAN keep you from having to engage with them as much!
		This menu allows you to [c/{$Mods.V2.Colors.Action}:ask the divines] to [c/{$Mods.V2.Colors.Green}:prevent certain categories of entity from eating you].
		Note that it will [c/{$Mods.V2.Colors.Red}:not prevent them from eating other people or things}; only you.
		'''
	ToggleStateGeneral: This type of pred currently {ToggleStatus}.
	ToggleStateGood: "[c/{$Mods.V2.Colors.Green}:can eat you]"
	ToggleStateBad: "[c/{$Mods.V2.Colors.Red}:can't eat you]"

	GenderRelated: {
		Male: {
			Title: Male
			Description: Covers all male preds. Normal guys, femboys, twinks, hunks...all those fun folks. They've all got b- beautiful bellies!
		}

		Female: {
			Title: Female
			Description: Covers all female preds. Goths, tomboys, werefoxes, plants, and more are all under this umbrella.
		}

		Genderless: {
			Title: Other
			Description: Covers all preds whose gender isn't necessarily one way or the other for our purposes. Most slimes, Captain Morgan, most fish, etc. all file under this.
		}
	}

	TypeRelated: {
		Bat: {
			Title: Bat
			Description: Covers all species of bats...which Terraria has a lot of. N- not that I'm complaining! The s- smallest creatures are the m- most fun to be f- food for, ehe. Also covers v- vampires by technicality...h- handsome v- vampires, ehehe...
		}

		Bird: {
			Title: Bird
			Description: Covers all species of bird, i- including harpies...oh, that reminds me! Did you know there are over 260 d- discovered and f- fed species of harpy that demivolved l- largely independent of one another?
		}

		Bug: {
			Title: Bug
			Description: Covers all insectoid creatures, of all shapes and s- sizes! Wouldn't cover any h- hungry video game b- bugs if you were playing one, though...
		}

		Canine: {
			Title: Canine
			Description: Covers all dogs and dog-adjacent creatures --- all part of the order Canidae! That includes dogs themselves, wolves, foxes, coyotes, jackals, dingoes...o- oh, I'm sorry. I- I usually forget some of those aren't animals you'd f- find around here...
		}

		Fish: {
			Title: Fish
			Description: Covers all fish, and fish-adjacent sea life. Also includes m- mermaids...s- sexy, s- starving mermaids...b- but! You don't look like you'd f- find many of those.
		}

		Object: {
			Title: Object
			Description: Covers all object/inanimate preds...b- but, if you don't mind, c- can I be l- lunch for your w- weapon? F- for science? I- I promise it'll belch up some tickets!
		}

		Plant: {
			Title: Plant
			Description: Covers all flowers, fruits, vegetables, trees, and other plants! J- just be sure you f- feed them lots of yummy f- fertilizer, sunlight, and a- angelmeat! That way, they g- grow up b- big and strong, and great for h- harvests!
		}

		Slime: {
			Title: Slime
			Description: Covers all slimes. ALL of them. And they're all lame, except one that YOU can't even meet here. Gosh, I hate slimes.
		}

		Spider: {
			Title: Spider
			Description: Covers all arachnids, not just spiders! Th- these aren't bundled in with the B- Bug category because arachnids universally have 8 legs in m- maturity, whereas insectoids have 6!
		}

		Townsfolk: {
			Title: Townsfolk
			Description:
				'''
				Covers all the various townsfolk that you can invite to your little corner of the world!...i- including me, if you s- squint a little!
				...I- I mean, it's a formality for angels like me, a- and it'd n- never be relevant FOR me wh- when I'd m- much rather be b- broiling inside y- your s- s- stomach...b- but!! It's polite to give the option!!
				'''
		}

		Undead: {
			Title: Undead
			Description: Covers all forms of the undead. I- I don't mind being zombie f- food in your place, i- if that's your worry!
		}
	}
}
